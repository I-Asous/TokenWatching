{
    "name": "Token Watching",
    "description": "Base Level Extension",
    "version": "1.0",
    "manifest_version": 3,
    "key": "",
    "permissions": ["activeTab", "cookies", "storage"],
    "host_permissions": [
      "https://united-skylark-6420.clerk.accounts.dev/*",
      "http://localhost:5173/*"
    ],
    "action": {
      "default_popup": "index.html",
      "default_icon": "Token_Watching_Logo.png"},
    "content_scripts":[
      {
        "matches": ["https://chatgpt.com/*"],
        "js": ["content.ts"]
      }
    ]
  }
